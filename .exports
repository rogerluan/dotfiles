#!/bin/bash

# Prevent oh-my-zsh from overriding the ~/.zshrc file.
export KEEP_ZSHRC='yes'

# Preferred editor for local and remote sessions
export EDITOR='code --wait'

# Prefer US English and use UTF-8.
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export LANGUAGE=en_US.UTF-8

# Avoid issues with `gpg` as installed via Homebrew.
# https://stackoverflow.com/a/42265848/96656
export GPG_TTY=$(tty);

export DOTFILES_DIR="$HOME/.dotfiles"

export MAGICK_HOME=/usr/local/Cellar/imagemagick@6/6.9.11-28/

export THEOS=~/theos

if [[ $(arch) == 'arm64' ]]; then
  export APPLE_SILICON=true
fi

# export JAVA_HOME=/Applications/Android\ Studio.app/Contents/jre/Contents/Home
# export JAVA_HOME=/usr/libexec/java_home
# stderr is discarded and the export is conditional: with no JDK installed,
# java_home prints a two-paragraph "Unable to locate a Java Runtime" nag to
# stderr and exits 1, which .exports being sourced by EVERY shell turned into
# noise at the top of every terminal tab (and inside every setup script log).
JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null) && export JAVA_HOME || unset JAVA_HOME

# pyenv root directory. Consumed by pyenv only.
export PYENV_ROOT="$HOME/.pyenv"

# Consumed by fastlane, which avoids printing the plugins table on every lane run
export FASTLANE_HIDE_PLUGINS_TABLE=true

export NODE_OPTIONS='--disable-warning=ExperimentalWarning'

# Claude Code terminal behaviour.
#
# Keeps Claude Code OUT of the terminal's alternate screen buffer, so it prints
# inline into normal scrollback instead of repainting the whole window and
# swallowing your history — i.e. it behaves like a regular command again.
export CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1

# Uncomment to also turn off mouse reporting. Claude Code enables it to handle
# clicks and scrolling, and while it's on, Terminal.app hands drags to the app
# instead of selecting text — which is why ⌘C-ing from the pane doesn't work
# without holding `fn`. Turning it off restores plain drag-to-select, at the
# cost of in-app click/scroll handling.
# export CLAUDE_CODE_DISABLE_MOUSE=1
