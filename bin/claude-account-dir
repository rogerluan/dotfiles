#!/bin/sh
# claude-account-dir — print the candidate CLAUDE_CONFIG_DIRs for a path,
# best-first, one per line. Empty output means "use Claude's default account":
# leave CLAUDE_CONFIG_DIR UNSET, since ~/.claude is a different config-file
# location than the unset default and re-onboards.
#
# A repo maps to a pool by the GitHub org of its `origin` remote:
# ~/.claude-<org>-<N>, tried in N order. Keying on the ORG rather than the
# on-disk path is what makes this survive random-slug worktrees, which share
# their source repo's git config.
#
# Add an account: create ~/.claude-<org>-<next-N>, then
# `CLAUDE_ACCOUNT_LOGIN=~/.claude-<org>-<N> claude` and /login.

dir=${1:-$PWD}
remote=$(git -C "$dir" remote get-url origin 2>/dev/null) || remote=""

org=$(printf '%s' "$remote" | sed -nE 's#.*github\.com[:/]+([^/]+)/.*#\1#p' | tr '[:upper:]' '[:lower:]')
[ -n "$org" ] || exit 0

# An unmatched glob stays literal and is filtered out by the -d test.
for d in "$HOME/.claude-$org-"*; do
  [ -d "$d" ] || continue
  case "${d##*-}" in
    ''|*[!0-9]*) continue ;;
  esac
  printf '%s\n' "$d"
done | sort -V
