#!/bin/sh
# claude-pick-account — choose ONE CLAUDE_CONFIG_DIR from the candidate pool on
# stdin (best-first, one per line, from claude-account-dir), based on usage.
#
# Never skips an account on a guess: if usage truly can't be read, the account is
# used as-is. The levers live in claude-accounts.conf.

set -eu
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/claude-usage

USAGE_AWARE=1
USAGE_THRESHOLD=95
USAGE_METRIC=max
USAGE_CACHE_TTL=600
USAGE_STALE_MAX=3600
ORG_FALLBACK_DEFAULT=0
[ -f "$SELF_DIR/claude-accounts.conf" ] && . "$SELF_DIR/claude-accounts.conf"
priv=${XDG_CONFIG_HOME:-$HOME/.config}/claude-accounts/accounts.conf
[ -f "$priv" ] && . "$priv"

input=$(cat)
[ -n "$input" ] || exit 0

set -f
IFS='
'
set -- $input
unset IFS
set +f

[ -n "${1:-}" ] || exit 0

# A single-account pool still goes through the loop below, so it can report
# "over threshold" to the caller.
if [ "$USAGE_AWARE" != "1" ]; then
  printf '%s\n' "$1"
  exit 0
fi

mkdir -p "$CACHE" 2>/dev/null || true
now=$(date +%s 2>/dev/null || echo 0)

choose() { printf '%s\n' "$1"; exit 0; }

last=""
for d in "$@"; do
  last=$d
  cf="$CACHE/$(basename "$d")"
  line=""
  stale=""

  # A stale reading is kept as a fallback for when the live re-check fails. The
  # usage endpoint has its own rate limit, separate from the account's session
  # limit, so "the check failed" is not the same as "we have no idea" — and
  # discarding a recent "this account is capped" on a failed re-check is what
  # sends every launch straight back onto a capped account.
  if [ -f "$cf" ]; then
    cts=$(cut -d' ' -f1 "$cf" 2>/dev/null || echo "")
    case "$cts" in
      ''|*[!0-9]*) : ;;
      *) if [ "$now" -gt 0 ]; then
           age=$((now - cts))
           [ "$age" -lt "$USAGE_STALE_MAX" ] && stale=$(cut -d' ' -f2- "$cf" 2>/dev/null)
           [ "$age" -lt "$USAGE_CACHE_TTL" ] && line=$stale
         fi ;;
    esac
  fi

  # Short timeout so a hang can't block launch.
  if [ -z "$line" ]; then
    fresh=$(CLAUDE_CONFIG_DIR="$d" CLAUDE_USAGE_MAX_TIME=5 "$SELF_DIR/claude-usage" 2>/dev/null || true)
    case "$fresh" in
      *=*) line=$fresh; printf '%s %s\n' "$now" "$fresh" > "$cf" 2>/dev/null || true ;;
      *) : ;;
    esac
  fi

  [ -n "$line" ] || line=$stale
  [ -n "$line" ] || choose "$d"

  util=$(printf '%s' "$line" | sed -n "s/.*$USAGE_METRIC=\([0-9.]*\).*/\1/p")
  [ -n "$util" ] || choose "$d"

  if awk "BEGIN{exit !($util < $USAGE_THRESHOLD)}" 2>/dev/null; then
    choose "$d"
  fi
done

# Whole pool over threshold. Handing back the last account keeps the session
# inside the org: it may be capped, but Claude Code says so and that is
# recoverable, whereas escaping to the default account lets the next /login bind
# the global slot to a work identity. See ORG_FALLBACK_DEFAULT.
if [ "$ORG_FALLBACK_DEFAULT" = "1" ]; then
  exit 0
fi
[ -n "$last" ] && printf '%s\n' "$last"
exit 0
